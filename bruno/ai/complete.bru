meta {
  name: AI Complete (SSE)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/ai/complete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "before": "function add(a, b) {",
    "after": "}",
    "language": "javascript"
  }
}

script:pre-request {
  // Ensure accessToken is set — in `-r` regression runs, `ai/` is alphabetically
  // ahead of `auth/`, so login has not run yet.
  if (!bru.getVar('accessToken')) {
    const axios = require('axios');
    const res = await axios.post(bru.getEnvVar('baseUrl') + '/api/auth/login', {
      email: 'testuser@example.com',
      password: 'password123',
    });
    bru.setVar('accessToken', res.data.accessToken);
  }
}

assert {
  res.status: eq 200
  res.headers.content-type: contains text/event-stream
}

script:post-response {
  // CI runs with LLM_PROVIDER=mock — ChatMock streams the deterministic
  // default script ['Hello', ' world', '[done]'] and the SSE handler emits
  // an `event: done` terminator. Verify both pieces of the wire format.
  if (typeof res.body !== 'string') {
    throw new Error('Expected SSE body to be a string, got: ' + typeof res.body);
  }
  if (res.body.indexOf('Hello') === -1) {
    throw new Error('Expected mock-provider SSE to contain "Hello"');
  }
  if (res.body.indexOf('event: done') === -1) {
    throw new Error('Expected SSE stream to contain a done event');
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("content-type is event-stream", function() {
    expect(res.headers['content-type']).to.match(/text\/event-stream/);
  });
}
