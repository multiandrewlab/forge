meta {
  name: Get Revision by Number
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/posts/{{postId}}/revisions/{{revisionNumber}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

docs {
  Returns a single revision by its revision number. Auth is required after
  #62 (WU4); the seeded {{postId}} is testuser-owned and public.
}
