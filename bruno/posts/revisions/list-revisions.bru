meta {
  name: List Revisions
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/posts/{{postId}}/revisions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

docs {
  Returns all revisions for a post. Auth is required after #62 (WU4); the
  seeded {{postId}} is testuser-owned and public so the request succeeds
  with the bootstrap token.
}
