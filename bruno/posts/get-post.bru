meta {
  name: Get Post by ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/posts/{{postId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

docs {
  Returns the post with all its revisions. Auth is required after #62 (WU4)
  enforced authentication on read routes; the seeded {{postId}} (c…0099) is
  testuser-owned and public so testuser's token resolves to a 200.
}
