meta {
  name: Fork Post
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/posts/{{forkablePostId}}/fork
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 201) {
    const body = res.getBody();
    bru.setVar("forkedPostId", body.post.id);
  }
}
