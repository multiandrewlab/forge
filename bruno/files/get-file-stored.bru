meta {
  name: Get File (Object Storage Redirect)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/posts/{{postId}}/files/{{createdFileId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

docs {
  Retrieve a file stored in object storage (MinIO).
  Files over 64 KB are stored in MinIO and the server returns
  a 302 redirect to a signed URL.

  Expected: 302 redirect to signed MinIO URL

  LIMITATION: This test reuses {{createdFileId}} from seq 1, which
  uploaded a small text file (inline storage). To truly test the 302
  redirect path, you need:
  1. MinIO running and configured (MINIO_ACCESS_KEY set)
  2. Upload a file > 64 KB
  3. Capture that file's ID
  4. Change assert to: res.status: eq 302

  The assert is set to 200 (inline fallback) so the collection run
  does not break when using the small test fixture.
}
