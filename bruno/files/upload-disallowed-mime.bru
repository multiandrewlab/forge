meta {
  name: Upload Disallowed MIME Type
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/health
  body: none
  auth: none
}

script:pre-request {
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const postId = bru.getEnvVar("postId");
  const token = bru.getVar("accessToken");

  const boundary = "----BrunoTestBoundary";
  const fileContent = "MZ\x90\x00"; // fake executable bytes
  const body =
    "--" + boundary + "\r\n" +
    'Content-Disposition: form-data; name="file"; filename="malware.exe"\r\n' +
    "Content-Type: application/x-executable\r\n" +
    "\r\n" +
    fileContent +
    "\r\n--" + boundary + "--\r\n";

  try {
    const res = await axios.post(
      baseUrl + "/api/posts/" + postId + "/files",
      body,
      {
        headers: {
          "content-type": "multipart/form-data; boundary=" + boundary,
          "authorization": "Bearer " + token
        }
      }
    );
    bru.setVar("_uploadStatus", String(res.status));
    bru.setVar("_uploadBody", JSON.stringify(res.data));
  } catch (err) {
    const st = err.response ? String(err.response.status) : "0";
    const bd = err.response ? JSON.stringify(err.response.data) : String(err.message);
    bru.setVar("_uploadStatus", st);
    bru.setVar("_uploadBody", bd);
  }
}

tests {
  test("upload disallowed MIME returns 415", () => {
    const status = parseInt(bru.getVar("_uploadStatus"));
    expect(status).to.equal(415);
  });
}

assert {
  res.status: eq 200
}

docs {
  Error-path test: upload a file with a disallowed MIME type (.exe).
  Uses axios workaround (Bruno CLI sends multipart-form as
  application/x-www-form-urlencoded). The carrier request is GET /api/health.
  The actual upload result is checked in the tests block via _uploadStatus.

  Expected upload response: 415 { error: "Unsupported media type" }
}
