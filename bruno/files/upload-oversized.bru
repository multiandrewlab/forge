meta {
  name: Upload Oversized File
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/health
  body: none
  auth: none
}

script:pre-request {
  const axios = require("axios");
  const baseUrl = bru.getEnvVar("baseUrl");
  const postId = bru.getEnvVar("postId");
  const token = bru.getVar("accessToken");

  const boundary = "----BrunoTestBoundary";
  // Generate a payload larger than the 10 MB server limit
  const fileContent = "x".repeat(10 * 1024 * 1024 + 1);
  const body =
    "--" + boundary + "\r\n" +
    'Content-Disposition: form-data; name="file"; filename="oversized.bin"\r\n' +
    "Content-Type: application/octet-stream\r\n" +
    "\r\n" +
    fileContent +
    "\r\n--" + boundary + "--\r\n";

  try {
    const res = await axios.post(
      baseUrl + "/api/posts/" + postId + "/files",
      body,
      {
        headers: {
          "content-type": "multipart/form-data; boundary=" + boundary,
          "authorization": "Bearer " + token
        },
        maxBodyLength: Infinity,
        maxContentLength: Infinity
      }
    );
    bru.setVar("_uploadStatus", String(res.status));
    bru.setVar("_uploadBody", JSON.stringify(res.data));
  } catch (err) {
    const st = err.response ? String(err.response.status) : "0";
    const bd = err.response ? JSON.stringify(err.response.data) : String(err.message);
    bru.setVar("_uploadStatus", st);
    bru.setVar("_uploadBody", bd);
  }
}

tests {
  test("upload oversized file is rejected", () => {
    const status = parseInt(bru.getVar("_uploadStatus"));
    const body = bru.getVar("_uploadBody");
    // Server may return 413 (Payload Too Large) or close the connection (status 0)
    // when the payload exceeds the limit. Either indicates the server rejected it.
    const rejected = status === 413 || status === 0;
    expect(rejected).to.equal(true, "expected 413 or connection reset, got " + status + ": " + body);
  });
}

assert {
  res.status: eq 200
}

docs {
  Error-path test: upload a file exceeding the 10 MB server limit.
  Uses axios workaround with "x".repeat(10 * 1024 * 1024 + 1) to generate
  a payload just over 10 MB. The carrier request is GET /api/health.
  The actual upload result is checked in the tests block via _uploadStatus.

  Expected upload response: 413 { error: "File too large" }

  NOTE: The server may close the connection before sending a proper 413
  response for very large payloads, resulting in status 0 (connection reset).
  The test accepts either 413 or 0 as valid rejections.
}
