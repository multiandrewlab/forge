meta {
  name: List Files (By Revision)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/posts/{{postId}}/files?revisionId={{revisionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

docs {
  List files attached to a specific revision of a post.
  Uses {{revisionId}} from the seeded test revision.
  Auth is required after #62 (WU4); the seeded {{postId}} is testuser-owned
  and public so the request succeeds with the bootstrap token.

  Response: 200 with { files: [...] }
}
