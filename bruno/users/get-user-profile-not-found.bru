meta {
  name: Get User Profile - Not Found
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/users/00000000-0000-0000-0000-000000000000
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 404
  res.body.error: eq User not found
}

docs {
  Request a profile for a non-existent user UUID.
  Expects a 404 with an error message.
}
