meta {
  name: List Comments by Revision
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/posts/{{postId}}/comments?revision={{revisionId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

docs {
  Fetch comments filtered to a specific revision (plus general comments with no revision).

  Response: { comments: Comment[] }

  Requires {{postId}} and {{revisionId}}. Auth is required after #62 (WU4);
  the seeded {{postId}} is testuser-owned and public.
}
