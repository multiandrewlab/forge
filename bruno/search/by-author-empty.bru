meta {
  name: search by author (empty → 400)
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/search?q=typescript&author=
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 400
}

docs {
  Validates that an empty author string is rejected with 400. The
  searchQuerySchema declares `author: z.string().min(1).max(100).optional()`.
  Issue #49.
}
