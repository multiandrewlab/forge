# Copy this file to .env and fill in your values
# NEVER commit .env — it is in .gitignore

# Database
DATABASE_URL=postgresql://forge:forge_dev@localhost:5432/forge

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=forge_minio
MINIO_SECRET_KEY=forge_minio_secret
MINIO_BUCKET=forge-uploads
STORAGE_PROVIDER=minio

# JWT Authentication
JWT_SECRET=dev-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# Google OAuth (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:3000

# AI / LLM
# Local development defaults to OpenAI. The AI autocomplete endpoint
# (/api/ai/complete) and its Bruno test (bruno/ai/complete.bru) both
# require LLM_PROVIDER + the provider's credential to be set before
# the AI routes will stream successfully.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4
OPENAI_API_KEY=

# --- Alternative: Ollama (local-only, no API key needed) ---
# Uncomment the block below and set LLM_PROVIDER=ollama to run a local
# model via the ollama service in docker-compose.yml. Make sure the
# service is running (`docker compose up ollama`) and the model is
# pulled (`docker exec -it <container> ollama pull gemma2`).
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma2
# OLLAMA_BASE_URL=http://localhost:11434

# --- Cloudflare Stream (issue #102) ---
# Leave CF_ACCOUNT_ID blank in dev to force the Mock CF Stream service
# (auto-fallback when CF_ACCOUNT_ID is unset), or set MOCK_CF_STREAM=1 to
# explicitly force the mock even when real CF_* vars are present.
# CF_STREAM_WEBHOOK_SECRET MUST match Bruno env `cfStreamWebhookSecret`
# (see bruno/environments/local.bru) so HMAC verification succeeds on
# WU7b's webhook regression tests.
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_WEBHOOK_SECRET=test-webhook-secret-do-not-use-in-prod
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_PEM=
CF_STREAM_CUSTOMER_SUBDOMAIN=
MOCK_CF_STREAM=
MOCK_SCRIPT_KEY_VIDEO_METADATA=
